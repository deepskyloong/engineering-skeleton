#!/bin/sh
set -eu

message_file=${1-}
if [ -z "$message_file" ] || [ ! -f "$message_file" ]; then
  printf '%s\n' 'commit-msg: no message file' >&2
  exit 1
fi

fail() {
  printf 'commit-msg: %s\n' "$1" >&2
  exit 1
}

# Merge commits do not follow the single-change header.
if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
  exit 0
fi

header=$(sed -n '1p' "$message_file")
[ -n "$header" ] || fail 'empty commit message'

line2=$(sed -n '2p' "$message_file")
if [ -n "$line2" ] && [ "${line2#\#}" = "$line2" ]; then
  fail 'body must start with a blank line'
fi

if ! printf '%s\n' "$header" | grep -Eq '^(feat|fix|refactor|docs|test|chore|ci|norm|template|skill|check)(\([a-z0-9][a-z0-9.-]*\))?!?: .+$'; then
  fail 'header must be <type>[(<scope>)][!]: <subject>'
fi

subject=${header#*: }
[ -n "$subject" ] || fail 'subject is empty'
case "$subject" in
  *.) fail 'subject must not end with a period' ;;
esac
subject_length=$(printf '%s' "$subject" | wc -m | tr -d ' ')
[ "$subject_length" -le 100 ] || fail 'subject exceeds 100 characters'

body_width=$(sed -n 's/^Body width: *\([0-9][0-9]*\)$/\1/p' docs/committing.md 2>/dev/null)
if [ -z "$body_width" ]; then
  hard_wrap=$(awk '
    BEGIN { fence = 0; previous = 0 }
    NR <= 2 { next }
    /^#/ { next }
    /^[[:space:]]*```/ { fence = !fence; previous = 0; next }
    fence { next }
    /^[[:space:]]*$/ { previous = 0; next }
    {
      if ($0 ~ /^[[:space:]]*([-*] |[0-9]+\. )/ || $0 ~ /^(BREAKING CHANGE|Refs|Fixes|Closes): /) {
        previous = 1
        next
      }
      if (previous == 1) {
        print NR
        exit
      }
      previous = 1
    }
  ' "$message_file")
  if [ -n "$hard_wrap" ]; then
    fail "hard-wrapped body at line $hard_wrap"
  fi
fi
